  "description": "MCP server for react-native-shader-orbs: look up orbs, check parameters against their real ranges, and write correct <ShaderOrb /> code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "react-native-shader-orbs-mcp": "cli.mjs"
  },
